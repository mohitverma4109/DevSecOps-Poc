    <suppress>
      <notes>False positive - CVE applies to unused code path, reviewed 2026-01-01</notes>
      <packageUrl regex="true">^pkg:npm/some-lib@.*$</packageUrl>
      <cve>CVE-2024-00000</cve>
    </suppress>
